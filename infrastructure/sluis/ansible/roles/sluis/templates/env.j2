# {{ ansible_managed }}
# Écrit par Ansible depuis le fichier SOPS du dépôt privé. Ne pas éditer ici :
# la prochaine exécution l'écraserait.

SLUIS_DOMAIN={{ sluis_domaine }}
SLUIS_SECRET_SIGNATURE={{ sluis_secret_signature }}
SLUIS_IDENTIFIANT={{ sluis_identifiant }}
SLUIS_EMPREINTE_MOT_DE_PASSE={{ sluis_empreinte_mot_de_passe }}
SLUIS_GITHUB_TOKEN={{ sluis_github_token | default('') }}

# Le Sluis public ne détient aucune clé OVH (ADR-010).
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
OVH_ENDPOINT=https://eu.api.ovh.com/1.0
{% if sluis_executant | bool %}

# ── Sluis exécutant ──
SLUIS_SECRET_SIGNATURE_EXECUTANT={{ sluis_secret_signature_executant }}
SLUIS_GITHUB_TOKEN_EXECUTANT={{ sluis_github_token_executant | default('') }}
OVH_BAC_A_SABLE_APPLICATION_KEY={{ ovh_bac_a_sable_application_key }}
OVH_BAC_A_SABLE_APPLICATION_SECRET={{ ovh_bac_a_sable_application_secret }}
OVH_BAC_A_SABLE_CONSUMER_KEY={{ ovh_bac_a_sable_consumer_key }}
OS_AUTH_URL={{ openstack_auth_url | default('') }}
OS_IDENTITY_API_VERSION={{ openstack_identity_api_version | default('3') }}
OS_USER_DOMAIN_NAME={{ openstack_user_domain_name | default('Default') }}
OS_PROJECT_DOMAIN_NAME={{ openstack_project_domain_name | default('Default') }}
OS_PROJECT_ID={{ openstack_project_id | default('') }}
OS_USERNAME={{ openstack_username | default('') }}
OS_PASSWORD={{ openstack_password | default('') }}
OS_REGION_NAME={{ openstack_region_name | default('') }}
SLUIS_DEPOTS={{ sluis_depots_mesures }}
{% endif %}
