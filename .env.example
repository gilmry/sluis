# Gabarit du .env du serveur. À copier en `.env`, à remplir, à ne jamais
# committer : le .gitignore l'exclut déjà.
#
#   cp .env.example .env

# Domaine public. Sert à la fois à la règle Traefik et à l'issuer OAuth.
SLUIS_DOMAIN=sluis.ecosolva.org

# Signature des jetons. Aucune valeur par défaut n'est acceptable : un secret
# par défaut est un secret public.
#   openssl rand -base64 32
SLUIS_SECRET_SIGNATURE=

# Le superviseur. Sluis n'a pas de table d'utilisateurs, il en sert un seul.
SLUIS_IDENTIFIANT=

# L'EMPREINTE du mot de passe, jamais le mot de passe.
#   printf '%s' 'votre-mot-de-passe' | sha256sum | cut -d' ' -f1
SLUIS_EMPREINTE_MOT_DE_PASSE=

# Identifiants OVH. Facultatifs : absents, `sluis_doctor` le signale et rien
# de ce qui touche à OVH ne répond. C'est un état normal, pas une panne.
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
OVH_ENDPOINT=https://eu.api.ovh.com/1.0

# Jeton GitHub à droit unique : déclencher un workflow. Aucun outil ne le
# consomme encore, la passerelle Tier 1 n'est pas câblée au registre MCP.
SLUIS_GITHUB_TOKEN=

# Image à déployer. Laisser vide pour suivre le tag latest de GHCR.
#SLUIS_IMAGE=ghcr.io/gilmry/sluis/server:latest
