# Gabarit du .env du serveur. À copier en `.env`, à remplir, à ne jamais
# committer : le .gitignore l'exclut déjà.
#
#   cp .env.example .env

# Domaine public. Sert à la fois à la règle Traefik et à l'issuer OAuth.
SLUIS_DOMAIN=sluis.ecosolva.org

# Signature des jetons. Aucune valeur par défaut n'est acceptable : un secret
# par défaut est un secret public.
#   openssl rand -base64 32
SLUIS_SECRET_SIGNATURE=

# Le superviseur. Sluis n'a pas de table d'utilisateurs, il en sert un seul.
SLUIS_IDENTIFIANT=

# L'EMPREINTE du mot de passe, jamais le mot de passe.
#   printf '%s' 'votre-mot-de-passe' | sha256sum | cut -d' ' -f1
SLUIS_EMPREINTE_MOT_DE_PASSE=

# Identifiants OVH du Sluis PUBLIC. Facultatifs, et le mieux est de les
# laisser vides : ce service est exposé à Internet, et ce qu'il ne détient pas
# ne peut pas lui être volé. Absents, `sluis_doctor` le signale et rien de ce
# qui touche à OVH ne répond. C'est un état normal, pas une panne.
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
OVH_ENDPOINT=https://eu.api.ovh.com/1.0

# Jeton GitHub à droit unique : déclencher un workflow. Aucun outil ne le
# consomme encore, la passerelle Tier 1 n'est pas câblée au registre MCP.
SLUIS_GITHUB_TOKEN=

# Image à déployer. Laisser vide pour suivre le tag latest de GHCR.
#SLUIS_IMAGE=ghcr.io/gilmry/sluis/server:latest

# ── Sluis exécutant ─────────────────────────────────────────────────────────
# Ne sert que si `sluis.executant.toml` existe à la racine. Sans ce fichier,
# deploy.sh ne déploie que le Sluis public et tout ce bloc reste ignoré.

# Signature des jetons de l'exécutant. **Doit différer de celle du public** :
# un secret commun ferait d'un jeton émis par le service exposé un jeton valide
# pour le service armé, et les deux déploiements n'en feraient plus qu'un.
#   openssl rand -base64 32
SLUIS_SECRET_SIGNATURE_EXECUTANT=

# Identifiants du projet OVH dédié aux bacs à sable (H1), restreints à ce seul
# projet. Ce sont les seules clés capables de louer, et elles ne vivent que
# sur l'exécutant.
OVH_BAC_A_SABLE_APPLICATION_KEY=
OVH_BAC_A_SABLE_APPLICATION_SECRET=
OVH_BAC_A_SABLE_CONSUMER_KEY=

# Racine, côté hôte, des dépôts à mesurer. Montée en /depots dans le conteneur,
# et c'est ce chemin-là, celui du conteneur, que `depots_autorises` déclare.
SLUIS_DEPOTS=/home/ubuntu/depots

# Image de l'exécutant. Laisser vide pour suivre le tag latest de GHCR.
#SLUIS_IMAGE_EXECUTANT=ghcr.io/gilmry/sluis/executant:latest
